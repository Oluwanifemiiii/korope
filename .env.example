# Copy to .env.local for development. Never commit real values.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Neon (project "Korope"). Use the branch for your environment: dev, ci or main.
# Pooled endpoint (host contains -pooler) for the app:
DATABASE_URL=postgresql://korope_owner:<password>@<endpoint>-pooler.<region>.aws.neon.tech/korope?sslmode=verify-full&channel_binding=require
# Direct endpoint for migrations (npm run db:migrate):
DATABASE_URL_UNPOOLED=postgresql://korope_owner:<password>@<endpoint>.<region>.aws.neon.tech/korope?sslmode=verify-full&channel_binding=require
# Neon "ci" branch, direct endpoint. npm run test:sql creates and drops korope_test there.
TEST_DATABASE_URL=

# --- Better Auth
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Google OAuth client (optional locally). Redirect URI: <site>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Africa's Talking SMS. AT_USERNAME=sandbox uses the simulator.
AT_USERNAME=sandbox
AT_API_KEY=
# Registered alphanumeric sender ID (needed in production for DND numbers)
AT_SENDER_ID=
# Development only: print OTP codes to the server log instead of sending. Ignored in production.
DEV_LOG_OTP=1

# --- Later milestones
NEXT_PUBLIC_NEON_REALTIME_URL=
NEON_REALTIME_SECRET=
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_SERVER_KEY=
NEXT_PUBLIC_MAP_ID_LIGHT=
NEXT_PUBLIC_MAP_ID_NIGHT=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
QR_SIGNING_SECRET=
SIMULATOR_TOKEN=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@korope.app
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
CRON_SECRET=
